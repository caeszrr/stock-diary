    "repair:tw-gaps": "node scripts/repair-tw-gaps.js",
    "validate": "node scripts/validate-tickers.js",
    "watchdog": "node scripts/watchdog.js",
    "watchdog:sweep": "WATCHDOG_SWEEP=1 node scripts/watchdog.js",
    "fetch:holidays": "node scripts/fetch-holidays.js",
    "test": "vitest run",
    "synthetic": "node scripts/synthetic-check.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "vite": "^8.1.1",
